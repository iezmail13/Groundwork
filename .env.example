# Copy to .env.local. `npx supabase status -o env` prints the local values.

# Supabase project URL and publishable (anon) key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Service-role key. Server-only: used by `npm run seed` and the
# development-only demo sign-in shortcut. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the app, used in magic-link redirects. Optional locally
# (derived from the request); set it on Vercel to your production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
